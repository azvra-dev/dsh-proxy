{
  "name": "@azvra-dev/dsh-proxy",
  "version": "1.0.0",
  "type": "module",
  "description": "Choose how DSH reaches the network: no proxy, or the Windows system proxy. Adds a sidebar page with the switch and latency checks.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "system-proxy"
  ],
  "license": "MIT",
  "author": "azvra-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azvra-dev/dsh-proxy.git"
  },
  "homepage": "https://github.com/azvra-dev/dsh-proxy#readme",
  "bugs": {
    "url": "https://github.com/azvra-dev/dsh-proxy/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
